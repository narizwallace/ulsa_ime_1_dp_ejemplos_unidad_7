{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Crear carpeta build",
            "type": "shell",
            "command": "mkdir -p build",
            "windows": {
                "command": "New-Item -ItemType Directory -Force build | Out-Null"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "Compilar y ejecutar ejemplo",
            "type": "shell",
            "command": "g++ -Wall -Wextra -std=c++17 \"${file}\" -o ./build/ejemplo && ./build/ejemplo",
            "windows": {
                "command": "g++ -Wall -Wextra -std=c++17 \"${file}\" -o ./build/ejemplo.exe; if ($?) { .\\build\\ejemplo.exe }"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Crear carpeta build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C/C++: g++ build active file",
            "type": "cppbuild",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c++17",
                "${file}",
                "-o",
                "./build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Crear carpeta build",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Compila con símbolos de depuración (la usa el depurador)"
        }
    ]
}